# Application
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medaichain

# JWT
JWT_SECRET=votre-secret-jwt-super-secure-changez-moi
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=votre-refresh-secret-changez-moi
JWT_REFRESH_EXPIRES_IN=30d

# Email (pour mot de passe oublié)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Service Python — ml_app.py : /predict (tier) + /predict-ml-api (2ᵉ modèle, copie ml-api → model_ml_api.pkl)
ML_SERVICE_URL=http://127.0.0.1:5000

# Service Python — OCR bilans (optionnel, ex. ml-ocr-api sur le port 5001)
OCR_FLASK_URL=http://127.0.0.1:5001
