{
  "name": "medaichain-backend",
  "version": "1.0.0",
  "description": "MEDAIChain Backend API with NestJS + MongoDB",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "concurrently -n nest,ml,ocr,ai,noshow -c blue,magenta,yellow,green,cyan \"nest start\" \"npm run ml:predict\" \"npm run ml:ocr\" \"node scripts/start_ai.js\" \"npm run ml:noshow\"",
    "start:dev": "kill-port 3000 && concurrently -n nest,ml,ocr,ai,noshow -c blue,magenta,yellow,green,cyan \"nest start --watch\" \"npm run ml:predict\" \"npm run ml:ocr\" \"node scripts/start_ai.js\" \"npm run ml:noshow\"",
    "start:debug": "concurrently -n nest,ml,ocr,ai,noshow -c blue,magenta,yellow,green,cyan \"nest start --debug --watch\" \"npm run ml:predict\" \"npm run ml:ocr\" \"node scripts/start_ai.js\" \"npm run ml:noshow\"",
    "ai-server": "node scripts/start_ai.js",
    "ai-server:bat": "start_ai_server.bat",
    "start:prod": "node dist/main",
    "ml:predict": "cd python && python3 ml_app.py",
    "ml:ocr": "cd python && python3 ocr_model.py",
    "ml:noshow": "cd python && python3 noshow_predict.py",
    "ml:train": "cd python && python3 train_noshow_model.py",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "agora-token": "^2.0.5",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ethers": "^6.16.0",
    "firebase-admin": "^13.5.0",
    "form-data": "^4.0.0",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-llama-cpp": "^2.8.1",
    "nodemailer": "^6.9.7",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tesseract.js": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.5",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.11",
    "@types/passport-jwt": "^3.0.10",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
